<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Target Name="ValidateHypervisorArchitecture" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(HypervisorArchitecture)'!='Intel' And '$(HypervisorArchitecture)'!='AMD'"
           Text="HypervisorArchitecture must be Intel or AMD." />
    <Error Condition="'$(Platform)'!='x64'" Text="hyperv-guest-memory requires Platform=x64." />
  </Target>
  <!-- The payload project copies the loader once; the solution's other projects share its output directory. -->
  <Target Name="CopyLoaderScript" AfterTargets="Build" Condition="'$(MSBuildProjectName)'=='hyperv-attachment'">
    <Copy SourceFiles="$(RepositoryRoot)load-hyperv-guest-memory.bat" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
